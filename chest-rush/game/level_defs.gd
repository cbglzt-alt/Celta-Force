class_name LevelDefs
extends RefCounted
## 多关卡数据定义。纯数据，不含逻辑。
## 改关卡配置只改这里；改数值平衡改 .tres。
## 地图 40×24 格（TILE=32 → 1280×768 世界）

class LevelDef:
	var name: String
	var map: Array[String]
	var quest_target: int = 3
	var round_interval: float = 22.0
	var extract_countdown: float = 75.0
	var spawn_radius: float = 220.0
	var knocker_first_round: int = 3

	func _init(n: String, m: Array[String], qt: int, ri: float, ec: float, sr: float, kr: int) -> void:
		name = n
		map = m
		quest_target = qt
		round_interval = ri
		extract_countdown = ec
		spawn_radius = sr
		knocker_first_round = kr


